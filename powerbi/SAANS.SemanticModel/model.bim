            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Live status text",
            "expression": "\"Latest live snapshot: run \" & FORMAT(MAX('Live status'[run_pkt]), \"d mmm yyyy, HH:mm\") & \" PKT · \" & FORMAT(SUM('Live status'[sensors_reporting]), \"0\") & \" sensors across 5 cities · \" & MAX('Live status'[fire_data]) & \". Refresh this report to load the newest snapshot from GitHub.\""
          }
        ]
