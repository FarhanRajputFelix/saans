                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"city\", type text}, {\"provider\", type text}, {\"type\", type text}, {\"location\", type text}, {\"lat\", type number}, {\"lon\", type number}, {\"first_utc\", type text}, {\"last_utc\", type text}, {\"days_in_period\", Int64.Type}}, \"en-US\")",
                "in",
