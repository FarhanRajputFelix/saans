        "partitions": [
          {
            "name": "Cleaned hourly",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    lahore = Table.SelectColumns(Table.PromoteHeaders(Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/FarhanRajputFelix/saans/main/\", [RelativePath = \"data/processed/csv/master_hourly_lahore.csv\"]), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]), {\"city\", \"time_pkt\", \"pm25\", \"pm25_source\", \"pm25_interpolated\", \"long_gap\", \"pm10\", \"temperature_2m\", \"relative_humidity_2m\", \"wind_speed_10m\", \"wind_direction_10m\", \"boundary_layer_height\", \"blh_imputed\", \"precipitation\", \"fires_300km\", \"is_test_season\", \"extreme_event\", \"fireworks_night\"}),",
                "    faisalabad = Table.SelectColumns(Table.PromoteHeaders(Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/FarhanRajputFelix/saans/main/\", [RelativePath = \"data/processed/csv/master_hourly_faisalabad.csv\"]), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]), {\"city\", \"time_pkt\", \"pm25\", \"pm25_source\", \"pm25_interpolated\", \"long_gap\", \"pm10\", \"temperature_2m\", \"relative_humidity_2m\", \"wind_speed_10m\", \"wind_direction_10m\", \"boundary_layer_height\", \"blh_imputed\", \"precipitation\", \"fires_300km\", \"is_test_season\", \"extreme_event\", \"fireworks_night\"}),",
                "    multan = Table.SelectColumns(Table.PromoteHeaders(Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/FarhanRajputFelix/saans/main/\", [RelativePath = \"data/processed/csv/master_hourly_multan.csv\"]), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]), {\"city\", \"time_pkt\", \"pm25\", \"pm25_source\", \"pm25_interpolated\", \"long_gap\", \"pm10\", \"temperature_2m\", \"relative_humidity_2m\", \"wind_speed_10m\", \"wind_direction_10m\", \"boundary_layer_height\", \"blh_imputed\", \"precipitation\", \"fires_300km\", \"is_test_season\", \"extreme_event\", \"fireworks_night\"}),",
                "    islamabad = Table.SelectColumns(Table.PromoteHeaders(Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/FarhanRajputFelix/saans/main/\", [RelativePath = \"data/processed/csv/master_hourly_islamabad.csv\"]), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]), {\"city\", \"time_pkt\", \"pm25\", \"pm25_source\", \"pm25_interpolated\", \"long_gap\", \"pm10\", \"temperature_2m\", \"relative_humidity_2m\", \"wind_speed_10m\", \"wind_direction_10m\", \"boundary_layer_height\", \"blh_imputed\", \"precipitation\", \"fires_300km\", \"is_test_season\", \"extreme_event\", \"fireworks_night\"}),",
                "    karachi = Table.SelectColumns(Table.PromoteHeaders(Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/FarhanRajputFelix/saans/main/\", [RelativePath = \"data/processed/csv/master_hourly_karachi.csv\"]), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]), {\"city\", \"time_pkt\", \"pm25\", \"pm25_source\", \"pm25_interpolated\", \"long_gap\", \"pm10\", \"temperature_2m\", \"relative_humidity_2m\", \"wind_speed_10m\", \"wind_direction_10m\", \"boundary_layer_height\", \"blh_imputed\", \"precipitation\", \"fires_300km\", \"is_test_season\", \"extreme_event\", \"fireworks_night\"}),",
                "    Combined = Table.Combine({lahore, faisalabad, multan, islamabad, karachi}),",
                "    Typed = Table.TransformColumnTypes(Combined, {{\"city\", type text}, {\"time_pkt\", type datetime}, {\"pm25\", type number}, {\"pm25_source\", type text}, {\"pm25_interpolated\", type text}, {\"long_gap\", type text}, {\"pm10\", type number}, {\"temperature_2m\", type number}, {\"relative_humidity_2m\", type number}, {\"wind_speed_10m\", type number}, {\"wind_direction_10m\", type number}, {\"boundary_layer_height\", type number}, {\"blh_imputed\", type text}, {\"precipitation\", type number}, {\"fires_300km\", type number}, {\"is_test_season\", type text}, {\"extreme_event\", type text}, {\"fireworks_night\", type text}}, \"en-US\"),",
                "    Proper = Table.TransformColumns(Typed, {{\"city\", Text.Proper, type text}}),",
                "    WithDate = Table.AddColumn(Proper, \"date\", each DateTime.Date([time_pkt]), type date)",
                "in",
                "    WithDate"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Average PM2.5",
            "expression": "AVERAGE('Cleaned hourly'[pm25])",
            "formatString": "0"
          }
        ],
