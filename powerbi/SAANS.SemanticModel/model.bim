            "name": "Live status",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/FarhanRajputFelix/saans/main/\", [RelativePath = \"powerbi/data/live_status.csv\"]), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"city\", type text}, {\"sensors_reporting\", Int64.Type}, {\"sensor_hours_received\", Int64.Type}, {\"sensor_hours_kept\", Int64.Type}, {\"hours_with_pm25_last_24h\", Int64.Type}, {\"result\", type text}, {\"run_pkt\", type datetime}, {\"fire_data\", type text}, {\"fire_detections\", Int64.Type}}, \"en-US\")",
