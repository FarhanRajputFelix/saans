{
  "name": "SAANS",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "fastCombine": true,
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Forecasts",
        "columns": [
          {
            "name": "forecast_id",
            "dataType": "string",
            "sourceColumn": "forecast_id",
            "summarizeBy": "none"
          },
          {
            "name": "issue_key",
            "dataType": "string",
            "sourceColumn": "issue_key",
            "summarizeBy": "none"
          },
          {
            "name": "mode",
            "dataType": "string",
            "sourceColumn": "mode",
            "summarizeBy": "none"
          },
          {
            "name": "season",
            "dataType": "string",
            "sourceColumn": "season",
            "summarizeBy": "none"
          },
          {
            "name": "city",
            "dataType": "string",
            "sourceColumn": "city",
            "summarizeBy": "none"
          },
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "summarizeBy": "none",
            "formatString": "d mmm yyyy"
          },
          {
            "name": "issued_pkt",
            "dataType": "dateTime",
            "sourceColumn": "issued_pkt",
            "summarizeBy": "none",
            "formatString": "d mmm yyyy HH:mm"
          },
          {
            "name": "last_24h",
            "dataType": "double",
            "sourceColumn": "last_24h",
            "summarizeBy": "sum",
            "formatString": "0"
          },
          {
            "name": "forecast_24h",
            "dataType": "double",
            "sourceColumn": "forecast_24h",
            "summarizeBy": "sum",
            "formatString": "0"
          },
          {
            "name": "q10",
            "dataType": "double",
            "sourceColumn": "q10",
            "summarizeBy": "sum"
          },
          {
            "name": "q90",
            "dataType": "double",
            "sourceColumn": "q90",
            "summarizeBy": "sum"
          },
          {
            "name": "aqi",
            "dataType": "double",
            "sourceColumn": "aqi",
            "summarizeBy": "sum",
            "formatString": "0"
          },
          {
            "name": "category",
            "dataType": "string",
            "sourceColumn": "category",
            "summarizeBy": "none"
          },
          {
            "name": "category_short",
            "dataType": "string",
            "sourceColumn": "category_short",
            "summarizeBy": "none"
          },
          {
            "name": "category_color",
            "dataType": "string",
            "sourceColumn": "category_color",
            "summarizeBy": "none"
          },
          {
            "name": "category_text_color",
            "dataType": "string",
            "sourceColumn": "category_text_color",
            "summarizeBy": "none"
          },
          {
            "name": "hazard_prob",
            "dataType": "double",
            "sourceColumn": "hazard_prob",
            "summarizeBy": "sum"
          },
          {
            "name": "forecast_48h",
            "dataType": "double",
            "sourceColumn": "forecast_48h",
            "summarizeBy": "sum",
            "formatString": "0"
          },
          {
            "name": "f48_aqi",
            "dataType": "double",
            "sourceColumn": "f48_aqi",
            "summarizeBy": "sum"
          },
          {
            "name": "f48_category",
            "dataType": "string",
            "sourceColumn": "f48_category",
            "summarizeBy": "none"
          },
          {
            "name": "observed_next_24h",
            "dataType": "double",
            "sourceColumn": "observed_next_24h",
            "summarizeBy": "sum"
          },
          {
            "name": "observed_aqi",
            "dataType": "double",
            "sourceColumn": "observed_aqi",
            "summarizeBy": "sum"
          },
          {
            "name": "observed_category",
            "dataType": "string",
            "sourceColumn": "observed_category",
            "summarizeBy": "none"
          },
          {
            "name": "error_24h",
            "dataType": "double",
            "sourceColumn": "error_24h",
            "summarizeBy": "sum"
          },
          {
            "name": "typical_level",
            "dataType": "double",
            "sourceColumn": "typical_level",
            "summarizeBy": "sum"
          },
          {
            "name": "top_drivers",
            "dataType": "string",
            "sourceColumn": "top_drivers",
            "summarizeBy": "none"
          },
          {
            "name": "advisory_english",
            "dataType": "string",
            "sourceColumn": "advisory_english",
            "summarizeBy": "none"
          },
          {
            "name": "advisory_urdu",
            "dataType": "string",
            "sourceColumn": "advisory_urdu",
            "summarizeBy": "none"
          },
          {
            "name": "advisory_source",
            "dataType": "string",
            "sourceColumn": "advisory_source",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Forecasts",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/FarhanRajputFelix/saans/main/\", [RelativePath = \"powerbi/data/forecasts.csv\"]), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"forecast_id\", type text}, {\"issue_key\", type text}, {\"mode\", type text}, {\"season\", type text}, {\"city\", type text}, {\"date\", type date}, {\"issued_pkt\", type datetime}, {\"last_24h\", type number}, {\"forecast_24h\", type number}, {\"q10\", type number}, {\"q90\", type number}, {\"aqi\", type number}, {\"category\", type text}, {\"category_short\", type text}, {\"category_color\", type text}, {\"category_text_color\", type text}, {\"hazard_prob\", type number}, {\"forecast_48h\", type number}, {\"f48_aqi\", type number}, {\"f48_category\", type text}, {\"observed_next_24h\", type number}, {\"observed_aqi\", type number}, {\"observed_category\", type text}, {\"error_24h\", type number}, {\"typical_level\", type number}, {\"top_drivers\", type text}, {\"advisory_english\", type text}, {\"advisory_urdu\", type text}, {\"advisory_source\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Forecast next 24 h",
            "expression": "AVERAGE(Forecasts[forecast_24h])",
            "formatString": "0"
          },
          {
            "name": "Forecast 24-48 h",
            "expression": "AVERAGE(Forecasts[forecast_48h])",
            "formatString": "0"
          },
          {
            "name": "Last 24 h",
            "expression": "AVERAGE(Forecasts[last_24h])",
            "formatString": "0"
          },
          {
            "name": "AQI next 24 h",
            "expression": "AVERAGE(Forecasts[aqi])",
            "formatString": "0"
          },
          {
            "name": "Risk level",
            "expression": "SELECTEDVALUE(Forecasts[category_short])"
          },
          {
            "name": "Category colour",
            "expression": "SELECTEDVALUE(Forecasts[category_color], \"#1b2029\")"
          },
          {
            "name": "Category text colour",
            "expression": "SELECTEDVALUE(Forecasts[category_text_color], \"#f0efec\")"
          },
          {
            "name": "Chance AQI above 300",
            "expression": "AVERAGE(Forecasts[hazard_prob])",
            "formatString": "0%"
          },
          {
            "name": "80% range",
            "expression": "IF(HASONEVALUE(Forecasts[forecast_id]), FORMAT(AVERAGE(Forecasts[q10]), \"0\") & \" to \" & FORMAT(AVERAGE(Forecasts[q90]), \"0\") & \" µg/m³\")"
          },
          {
            "name": "Typical level",
            "expression": "AVERAGE(Forecasts[typical_level])",
            "formatString": "0"
          },
          {
            "name": "Observed next 24 h",
            "expression": "AVERAGE(Forecasts[observed_next_24h])",
            "formatString": "0"
          },
          {
            "name": "City headline",
            "expression": "IF(HASONEVALUE(Forecasts[forecast_id]), SELECTEDVALUE(Cities[City]) & \": \" & FORMAT([Forecast next 24 h], \"0\") & \" µg/m³ next 24 h · US EPA AQI \" & FORMAT([AQI next 24 h], \"0\") & \" · \" & [Risk level] & \" · chance of AQI > 300: \" & FORMAT([Chance AQI above 300], \"0%\"), \"Select one city\")"
          },
          {
            "name": "Forecast details",
            "expression": "IF(HASONEVALUE(Forecasts[forecast_id]), \"80% range \" & [80% range] & \" · last 24 h \" & FORMAT([Last 24 h], \"0\") & \" · the 24 hours after that: \" & FORMAT([Forecast 24-48 h], \"0\") & \" µg/m³ (\" & SELECTEDVALUE(Forecasts[f48_category]) & \")\")"
          },
          {
            "name": "Why caption",
            "expression": "IF(HASONEVALUE(Forecasts[forecast_id]), \"Typical level \" & FORMAT([Typical level], \"0\") & \" µg/m³ + driver contributions = \" & FORMAT([Forecast next 24 h], \"0\") & \" µg/m³. Strongest single factors: \" & SELECTEDVALUE(Forecasts[top_drivers]) & \". SHAP shows what the model relied on: statistical, not a chemical source measurement.\")"
          },
          {
            "name": "Replay check",
            "expression": "IF(HASONEVALUE(Forecasts[forecast_id]), IF(ISBLANK([Observed next 24 h]), \"No complete observation for the next 24 hours.\", \"What actually happened: the next 24 hours averaged \" & FORMAT([Observed next 24 h], \"0\") & \" µg/m³ (AQI \" & FORMAT(AVERAGE(Forecasts[observed_aqi]), \"0\") & \", \" & SELECTEDVALUE(Forecasts[observed_category]) & \"). Forecast error: \" & FORMAT([Forecast next 24 h] - [Observed next 24 h], \"+0;-0;0\") & \" µg/m³.\"))"
          },
          {
            "name": "Advisory English",
            "expression": "SELECTEDVALUE(Forecasts[advisory_english])"
          },
          {
            "name": "Advisory Urdu",
            "expression": "SELECTEDVALUE(Forecasts[advisory_urdu])"
          },
          {
            "name": "Advisory source",
            "expression": "IF(HASONEVALUE(Forecasts[forecast_id]), \"Source: \" & SELECTEDVALUE(Forecasts[advisory_source]))"
          },
          {
            "name": "Mean absolute error",
            "expression": "AVERAGEX(FILTER(Forecasts, NOT ISBLANK(Forecasts[error_24h])), ABS(Forecasts[error_24h]))",
            "formatString": "0.0"
          }
        ]
      },
      {
        "name": "Issues",
        "columns": [
          {
            "name": "issue_key",
            "dataType": "string",
            "sourceColumn": "issue_key",
            "summarizeBy": "none"
          },
          {
            "name": "mode",
            "dataType": "string",
            "sourceColumn": "mode",
            "summarizeBy": "none"
          },
          {
            "name": "season",
            "dataType": "string",
            "sourceColumn": "season",
            "summarizeBy": "none"
          },
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "summarizeBy": "none",
            "formatString": "d mmm yyyy"
          },
          {
            "name": "issued_pkt",
            "dataType": "dateTime",
            "sourceColumn": "issued_pkt",
            "summarizeBy": "none",
            "formatString": "d mmm yyyy HH:mm"
          }
        ],
        "partitions": [
          {
            "name": "Issues",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/FarhanRajputFelix/saans/main/\", [RelativePath = \"powerbi/data/issues.csv\"]), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"issue_key\", type text}, {\"mode\", type text}, {\"season\", type text}, {\"date\", type date}, {\"issued_pkt\", type datetime}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Issued",
            "expression": "\"Issued \" & FORMAT(MAX(Issues[issued_pkt]), \"ddd d mmm yyyy, HH:mm\") & \" PKT\""
          }
        ]
      },
      {
        "name": "Cities",
        "columns": [
          {
            "name": "city_key",
            "dataType": "string",
            "sourceColumn": "city_key",
            "summarizeBy": "none"
          },
          {
            "name": "City",
            "dataType": "string",
            "sourceColumn": "City",
            "summarizeBy": "none",
            "sortByColumn": "order"
          },
          {
            "name": "latitude",
            "dataType": "double",
            "sourceColumn": "latitude",
            "summarizeBy": "none",
            "dataCategory": "Latitude"
          },
          {
            "name": "longitude",
            "dataType": "double",
            "sourceColumn": "longitude",
            "summarizeBy": "none",
            "dataCategory": "Longitude"
          },
          {
            "name": "in_training",
            "dataType": "string",
            "sourceColumn": "in_training",
            "summarizeBy": "none"
          },
          {
            "name": "order",
            "dataType": "int64",
            "type": "calculated",
            "summarizeBy": "none",
            "isHidden": true,
            "expression": "SWITCH(Cities[city_key], \"lahore\", 1, \"faisalabad\", 2, \"multan\", 3, \"islamabad\", 4, 5)"
          }
        ],
        "partitions": [
          {
            "name": "Cities",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/FarhanRajputFelix/saans/main/\", [RelativePath = \"powerbi/data/cities.csv\"]), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"city_key\", type text}, {\"City\", type text}, {\"latitude\", type number}, {\"longitude\", type number}, {\"in_training\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Drivers",
        "columns": [
          {
            "name": "forecast_id",
            "dataType": "string",
            "sourceColumn": "forecast_id",
            "summarizeBy": "none"
          },
          {
            "name": "driver_group",
            "dataType": "string",
            "sourceColumn": "driver_group",
            "summarizeBy": "none"
          },
          {
            "name": "ug_m3",
            "dataType": "double",
            "sourceColumn": "ug_m3",
            "summarizeBy": "sum"
          },
          {
            "name": "group_order",
            "dataType": "int64",
            "sourceColumn": "group_order",
            "summarizeBy": "none"
          },
          {
            "name": "group_color",
            "dataType": "string",
            "sourceColumn": "group_color",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Drivers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/FarhanRajputFelix/saans/main/\", [RelativePath = \"powerbi/data/drivers.csv\"]), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"forecast_id\", type text}, {\"driver_group\", type text}, {\"ug_m3\", type number}, {\"group_order\", Int64.Type}, {\"group_color\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Driver contribution",
            "expression": "SUM(Drivers[ug_m3])",
            "formatString": "+0;-0;0"
          }
        ]
      },
      {
        "name": "WhatIf",
        "columns": [
          {
            "name": "forecast_id",
            "dataType": "string",
            "sourceColumn": "forecast_id",
            "summarizeBy": "none"
          },
          {
            "name": "fire_reduction_pct",
            "dataType": "int64",
            "sourceColumn": "fire_reduction_pct",
            "summarizeBy": "none"
          },
          {
            "name": "forecast_ug_m3",
            "dataType": "double",
            "sourceColumn": "forecast_ug_m3",
            "summarizeBy": "sum"
          },
          {
            "name": "aqi",
            "dataType": "double",
            "sourceColumn": "aqi",
            "summarizeBy": "sum",
            "formatString": "0"
          },
          {
            "name": "category",
            "dataType": "string",
            "sourceColumn": "category",
            "summarizeBy": "none"
          },
          {
            "name": "category_color",
            "dataType": "string",
            "sourceColumn": "category_color",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "WhatIf",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/FarhanRajputFelix/saans/main/\", [RelativePath = \"powerbi/data/whatif.csv\"]), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"forecast_id\", type text}, {\"fire_reduction_pct\", Int64.Type}, {\"forecast_ug_m3\", type number}, {\"aqi\", type number}, {\"category\", type text}, {\"category_color\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "What-if forecast",
            "expression": "VAR r = [Fire reduction value] RETURN CALCULATE(AVERAGE(WhatIf[forecast_ug_m3]), WhatIf[fire_reduction_pct] = r)",
            "formatString": "0"
          },
          {
            "name": "What-if AQI",
            "expression": "VAR r = [Fire reduction value] RETURN CALCULATE(AVERAGE(WhatIf[aqi]), WhatIf[fire_reduction_pct] = r)",
            "formatString": "0"
          },
          {
            "name": "What-if text",
            "expression": "VAR r = [Fire reduction value] VAR f = [What-if forecast] RETURN IF(HASONEVALUE(Forecasts[forecast_id]), \"With \" & r & \"% fewer upwind crop fires: \" & FORMAT(f, \"0\") & \" µg/m³, AQI \" & FORMAT([What-if AQI], \"0\") & \" (\" & CALCULATE(SELECTEDVALUE(WhatIf[category]), WhatIf[fire_reduction_pct] = r) & \"), \" & FORMAT(f - [Forecast next 24 h], \"+0;-0;0\") & \" µg/m³ against the forecast. A model-based estimate: fire features are \" & \"scaled down and the forecast recomputed, everything else fixed; fewer fires can never raise a forecast.\")"
          },
          {
            "name": "What-if colour",
            "expression": "VAR r = [Fire reduction value] RETURN CALCULATE(SELECTEDVALUE(WhatIf[category_color], \"#1b2029\"), WhatIf[fire_reduction_pct] = r)"
          }
        ]
      },
      {
        "name": "Chart",
        "columns": [
          {
            "name": "forecast_id",
            "dataType": "string",
            "sourceColumn": "forecast_id",
            "summarizeBy": "none"
          },
          {
            "name": "hours_from_issue",
            "dataType": "int64",
            "sourceColumn": "hours_from_issue",
            "summarizeBy": "none"
          },
          {
            "name": "time_pkt",
            "dataType": "dateTime",
            "sourceColumn": "time_pkt",
            "summarizeBy": "none",
            "formatString": "d mmm yyyy HH:mm"
          },
          {
            "name": "observed",
            "dataType": "double",
            "sourceColumn": "observed",
            "summarizeBy": "sum"
          },
          {
            "name": "actual_after",
            "dataType": "double",
            "sourceColumn": "actual_after",
            "summarizeBy": "sum"
          },
          {
            "name": "forecast",
            "dataType": "double",
            "sourceColumn": "forecast",
            "summarizeBy": "sum"
          },
          {
            "name": "band_low",
            "dataType": "double",
            "sourceColumn": "band_low",
            "summarizeBy": "sum"
          },
          {
            "name": "band_high",
            "dataType": "double",
            "sourceColumn": "band_high",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "Chart",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/FarhanRajputFelix/saans/main/\", [RelativePath = \"powerbi/data/chart_hourly.csv\"]), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"forecast_id\", type text}, {\"hours_from_issue\", Int64.Type}, {\"time_pkt\", type datetime}, {\"observed\", type number}, {\"actual_after\", type number}, {\"forecast\", type number}, {\"band_low\", type number}, {\"band_high\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Observed (hourly)",
            "expression": "AVERAGE(Chart[observed])",
            "formatString": "0"
          },
          {
            "name": "What actually happened",
            "expression": "AVERAGE(Chart[actual_after])",
            "formatString": "0"
          },
          {
            "name": "Forecast (next 48 h)",
            "expression": "AVERAGE(Chart[forecast])",
            "formatString": "0"
          },
          {
            "name": "80% range low",
            "expression": "AVERAGE(Chart[band_low])",
            "formatString": "0"
          },
          {
            "name": "80% range high",
            "expression": "AVERAGE(Chart[band_high])",
            "formatString": "0"
          },
          {
            "name": "Hazardous (AQI 300)",
            "expression": "IF(NOT ISEMPTY(Chart), 225.5)",
            "formatString": "0"
          }
        ]
      },
      {
        "name": "MapPoints",
        "columns": [
          {
            "name": "issue_key",
            "dataType": "string",
            "sourceColumn": "issue_key",
            "summarizeBy": "none"
          },
          {
            "name": "kind",
            "dataType": "string",
            "sourceColumn": "kind",
            "summarizeBy": "none"
          },
          {
