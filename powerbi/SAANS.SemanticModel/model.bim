            "sourceColumn": "RMSE_model",
            "summarizeBy": "sum",
            "formatString": "0.0"
          },
          {
            "name": "MAE_persistence",
            "dataType": "double",
            "sourceColumn": "MAE_persistence",
            "summarizeBy": "sum",
            "formatString": "0.0"
          },
          {
            "name": "RMSE_persistence",
            "dataType": "double",
            "sourceColumn": "RMSE_persistence",
            "summarizeBy": "sum",
            "formatString": "0.0"
          },
          {
            "name": "MAE_seasonal",
            "dataType": "double",
            "sourceColumn": "MAE_seasonal",
            "summarizeBy": "sum",
            "formatString": "0.0"
          },
          {
            "name": "RMSE_seasonal",
            "dataType": "double",
            "sourceColumn": "RMSE_seasonal",
            "summarizeBy": "sum"
          },
          {
            "name": "skill_vs_persistence",
            "dataType": "double",
            "sourceColumn": "skill_vs_persistence",
            "summarizeBy": "sum",
            "formatString": "+0.0%;-0.0%;0.0%"
          }
        ],
        "partitions": [
          {
            "name": "Model accuracy",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Web.Contents(\"https://raw.githubusercontent.com/FarhanRajputFelix/saans/main/\", [RelativePath = \"powerbi/data/evaluation_regression.csv\"]), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"season\", type text}, {\"horizon\", type text}, {\"city\", type text}, {\"unseen_city\", type text}, {\"hours\", Int64.Type}, {\"mean_pm25\", type number}, {\"MAE_model\", type number}, {\"RMSE_model\", type number}, {\"MAE_persistence\", type number}, {\"RMSE_persistence\", type number}, {\"MAE_seasonal\", type number}, {\"RMSE_seasonal\", type number}, {\"skill_vs_persistence\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Skill vs persistence",
            "expression": "AVERAGE('Model accuracy'[skill_vs_persistence])",
            "formatString": "+0.0%;-0.0%;0.0%"
          }
        ]
      },
