{
  "name": "SAANS dark",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#6250d6",
    "#e34948"
  ],
  "background": "#0b0e14",
  "foreground": "#f0efec",
  "tableAccent": "#3987e5",
  "textClasses": {
    "callout": {
      "fontSize": 22,
      "fontFace": "Segoe UI Semibold",
      "color": "#f0efec"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#f0efec"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#f0efec"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#c3c2b7"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#161a22"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#2a2f3a"
              }
            },
            "radius": 10
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#f0efec"
              }
            }
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#161a22"
              }
            },
            "foreground": {
              "solid": {
                "color": "#c3c2b7"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0b0e14"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0b0e14"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "filter": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#161a22"
              }
            }
          }
        ]
      }
    }
  }
}