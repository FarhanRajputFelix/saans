# Copy this file to .env and paste your keys there. .env is git-ignored: never commit real keys.
# In Google Colab, add the same names under the key icon (Secrets) instead.

# OpenAQ v3 (free): sign up at https://explore.openaq.org/register, then copy the key from your account settings
OPENAQ_API_KEY=

# NASA FIRMS (free): request a MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# LLM for news event extraction and the English/Urdu advisories. Gemini is primary, Groq is the fallback.
# Gemini: https://aistudio.google.com/apikey    Groq: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
